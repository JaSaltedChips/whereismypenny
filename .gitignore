# Android build output
.gradle/
build/
app/build/

# Android Studio project files (machine-specific)
*.iml
.idea/
local.properties
.DS_Store
captures/

# Gradle cache (not the wrapper itself - wrapper is committed)
.gradle

# Signing keys and credentials - NEVER commit these
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties

# Real financial data - NEVER commit these
*.db
*.sqlite
*.sqlite3
data/*.json

# Generated schema files are committed; build output is not
app/build/generated/

# Android SDK location (machine-specific - use local.properties)
sdk.dir
