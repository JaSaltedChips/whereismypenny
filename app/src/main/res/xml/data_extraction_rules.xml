<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API ≥ 31): controls both Auto Backup and device-to-device transfer.
    Exclude database from both so financial records are not silently copied
    by the platform without user-initiated export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="wheresmypenny.db" />
        <exclude domain="database" path="wheresmypenny.db-shm" />
        <exclude domain="database" path="wheresmypenny.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="wheresmypenny.db" />
    </device-transfer>
</data-extraction-rules>
